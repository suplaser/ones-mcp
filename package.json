{
  "name": "@suplaser/onces-mcp",
  "version": "0.2.0",
  "description": "A TypeScript MCP server backed by the ONES Open API and personal API keys.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suplaser/ones-mcp.git"
  },
  "homepage": "https://github.com/suplaser/ones-mcp#readme",
  "bugs": {
    "url": "https://github.com/suplaser/ones-mcp/issues"
  },
  "type": "module",
  "bin": {
    "onces-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "setup": "npm run build && node dist/index.js setup",
    "test": "npm run build && node --test test/*.test.mjs",
    "auth:login": "node dist/index.js auth login",
    "auth:status": "node dist/index.js auth status",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "jsonc-parser": "^3.3.1",
    "open": "^11.0.4",
    "proper-lockfile": "^4.1.2",
    "toml-eslint-parser": "^1.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.4.0",
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2"
  }
}
